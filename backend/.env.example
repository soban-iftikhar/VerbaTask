PORT=8080

# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_connection_string_here

# Meta WhatsApp Cloud API — Developer/test mode (instant, no business verification)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-reuse-it-in-the-meta-console
WHATSAPP_APP_SECRET=your_app_secret_here


# Base URL of the web signup page (sent to unregistered WhatsApp numbers with their linking code)
SIGNUP_BASE_URL=https://verbatask.netlify.app/signup

# LLM provider for the NLP layer (intent parsing + onboarding extraction).
# 'groq' = free tier, no card, uses GROQ_API_KEY (hosts current Qwen models).
# 'dashscope' = Alibaba Model Studio, uses DASHSCOPE_API_KEY (requires activation).
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# Alibaba Cloud DashScope (Qwen-2.5) — NLP when LLM_PROVIDER=dashscope.
# IMPORTANT: keys from Model Studio International (sk-ws-... prefix) only work on
# the intl endpoint; the backend defaults to https://dashscope-intl.aliyuncs.com.
# New accounts must activate the model / claim the free quota in the Model Studio
# console, or every call returns 403 AccessDenied.Unpurchased.
# Optional overrides:
#   DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com  (for China-region keys)
#   QWEN_MODEL=qwen2.5-72b-instruct
DASHSCOPE_API_KEY=

# Groq (free tier, no card) — Whisper voice-note transcription AND the NLP
# chat layer when LLM_PROVIDER=groq. Get a key at console.groq.com.
GROQ_API_KEY=

# Alibaba Cloud Visual Intelligence (OCR) — only needed if you build the OCR module
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=

# Auth
JWT_SECRET=change-me-to-something-long-and-random

# Voice Out (Text-to-Speech)
# Provider: 'elevenlabs' (ultra-realistic, uses ELEVENLABS_API_KEY), 'gemini' (free from Google AI Studio, uses GEMINI_API_KEY), or 'edge' (default zero-config)
TTS_PROVIDER=edge

# Google Gemini API key (Free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ElevenLabs API key (Free 10,000 chars/mo at https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

TTS_VOICE_URDU=ur-PK-AsadNeural
TTS_VOICE_ENGLISH=en-US-GuyNeural
# Reply mode: 'voice_on_voice' (reply voice if merchant sent audio), 'always_voice', or 'text_only'
VOICE_REPLY_MODE=voice_on_voice
# Send companion text receipt alongside the voice note
VOICE_REPLY_SEND_COMPANION_TEXT=true
